# OpenRouter — универсальный LLM gateway
# Ключ: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# Модель — любая из https://openrouter.ai/models
# Примеры: anthropic/claude-sonnet-4-5 | openai/gpt-4o | google/gemini-2.0-flash-001
VITE_LLM_MODEL=anthropic/claude-sonnet-4-5

# URL приложения (для HTTP-Referer в OpenRouter)
VITE_APP_URL=http://localhost:5173

# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
