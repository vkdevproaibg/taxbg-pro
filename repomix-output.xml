                )}
                {hasTheoryPractice && (
                  <button
                    className="text-xs underline"
                    style={{ color: '#92400e' }}
                    onClick={e => {
                      e.stopPropagation()
                      setExpanded(x => !x)
                    }}>
                    {expanded ? 'Скрыть ↑' : 'Теория vs практика ↓'}
                  </button>
                )}
              </div>

              {/* Theory vs Practice */}
              {expanded && hasTheoryPractice && (
                <div
                  className="mt-2 rounded-xl overflow-hidden"
