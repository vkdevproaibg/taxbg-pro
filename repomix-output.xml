                  <span className="font-mono" style={{ color: 'var(--text-secondary)' }}>{a.account}</span>
                  <span className="font-mono" style={{ color: a.amount < 0 ? '#dc2626' : 'var(--text-primary)' }}>{a.amount.toFixed(2)}</span>
