        zone: 'green',
        risk: 'low',
        riskDetails: 'Полностью легально. Обычная практика для небольших IT компаний в Болгарии.',
        legalBasis: 'ЗДДФЛ чл. 29 · КСО',
        requiredActions: [
          'Зарегистрироваться как самоосигуряващ се (бесплатно в НАП)',
