@import "tailwindcss";

:root {
  font-family: Inter, system-ui, Avenir, Helvetica, Arial, sans-serif;

  /* Bulgarian national colors */
  --bg-white: #ffffff;
  --bg-green: #00966e;
  --bg-red: #d62612;

  /* Primary accent */
  --accent: #00966e;
  --accent-dark: #007a59;
  --accent-light: #e6f4f0;
  --accent-text: #005c44;

  /* Danger */
  --danger: #d62612;
  --danger-dark: #b01f0e;
  --danger-light: #fdf0ee;
  --danger-text: #8c1a0b;

  /* Neutrals */
  --surface: #f8faf9;
  --surface-sidebar: #dde8e2;
  --surface-card: #ffffff;
  --border: #e2ece9;
  --border-strong: #c8ddd8;
  --text-primary: #0f2420;
  --text-secondary: #3d5c55;
  --text-muted: #7a9e97;

  /* Surface effects */
  --paper-tint: #f6f3eb;
  --shadow-soft: 0 8px 24px rgba(8, 34, 28, 0.06);
  --shadow-card: 0 10px 26px rgba(8, 34, 28, 0.08);
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.72), transparent 45%),
    linear-gradient(180deg, var(--paper-tint) 0%, var(--surface) 55%);
  color: var(--text-primary);
}

/* Bulgarian flag stripe */
.bg-flag-stripe {
  background: linear-gradient(
    to right,
    #ffffff 0% 33.3%,
    #00966e 33.3% 66.6%,
    #d62612 66.6% 100%
  );
}

/* Subtle decorative folk pattern */
.bg-folk-pattern {
  background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cpath d='M0 20h40M20 0v40' stroke='%2300966E' stroke-width='0.5' stroke-opacity='0.15'/%3E%3Cpath d='M10 10l10-10 10 10-10 10z' stroke='%23D62612' stroke-width='0.5' stroke-opacity='0.1' fill='none'/%3E%3Cpath d='M10 30l10-10 10 10-10 10z' stroke='%23D62612' stroke-width='0.5' stroke-opacity='0.1' fill='none'/%3E%3Ccircle cx='20' cy='20' r='2' fill='%2300966E' fill-opacity='0.1'/%3E%3Ccircle cx='0' cy='0' r='2' fill='%2300966E' fill-opacity='0.1'/%3E%3Ccircle cx='40' cy='0' r='2' fill='%2300966E' fill-opacity='0.1'/%3E%3Ccircle cx='0' cy='40' r='2' fill='%2300966E' fill-opacity='0.1'/%3E%3Ccircle cx='40' cy='40' r='2' fill='%2300966E' fill-opacity='0.1'/%3E%3C/g%3E%3C/svg%3E");
}

/* Rose accent */
.rose-accent::before {
  content: "🌹";
  margin-right: 6px;
}

/* Reusable panel and ornament helpers for next layers */
.panel-card {
  background: var(--surface-card);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow-soft);
}

.embroidery-divider {
  height: 4px;
  border-radius: 9999px;
  background-image: repeating-linear-gradient(
    90deg,
