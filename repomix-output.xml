  const statusLabel =
    alert.status === 'pending'
      ? labels.statusPending
      : alert.status === 'reviewing'
        ? labels.statusReviewing
        : alert.status === 'applied'
          ? labels.statusApplied
          : labels.statusDismissed

  return (
    <div
