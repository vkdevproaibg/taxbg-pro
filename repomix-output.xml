    categoriesTitle: 'Категорії cookies',
    necessary: 'Необхідні (автентифікація, сесія)',
    necessaryDesc: 'Потрібні для входу, безпеки та збереження налаштувань.',
    alwaysOn: 'Завжди увімкнені',
