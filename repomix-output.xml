  // Nested handlers
  const handleSpouse = (field: keyof SpouseData) =>
    (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) =>
      setForm(prev => ({
        ...prev,
        spouse: { ...prev.spouse, [field]: e.target.value },
      }))

