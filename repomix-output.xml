import { useState } from 'react'
import { isSupabaseConfigured, supabase } from '../lib/supabase'
import { enableLocalAdminSession } from '../hooks/useAuth'

type Mode = 'login' | 'register'

function mapAuthError(message: string): string {
  const lower = message.toLowerCase()

  if (lower.includes('invalid login credentials')) return 'Неверный email или пароль.'
  if (lower.includes('email not confirmed')) return 'Email не подтвержден. Подтвердите почту в Supabase Users вручную или включите авто-подтверждение новых пользователей.'
  if (lower.includes('user already registered')) return 'Пользователь с таким email уже зарегистрирован.'
  if (lower.includes('password should be at least')) return 'Пароль должен быть не короче 6 символов.'
  if (lower.includes('unable to validate email address')) return 'Некорректный формат email.'
  if (lower.includes('email rate limit exceeded')) return 'Слишком много попыток. Попробуйте позже.'
  if (lower.includes('signup is disabled')) return 'Регистрация отключена в настройках Supabase (Auth > Providers > Email).'
  if (lower.includes('database error saving new user')) return 'Ошибка БД при создании пользователя. Проверьте настройки Auth и триггеры в Supabase.'

  return message
}

export default function Auth() {
  const [mode, setMode] = useState<Mode>('login')
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [success, setSuccess] = useState<string | null>(null)

  const handleAdminLogin = () => {
    setError(null)
    setSuccess(null)
    enableLocalAdminSession()
    window.location.reload()
  }

  const handleSubmit = async () => {
    setError(null)
    setSuccess(null)

    const normalizedEmail = email.trim().toLowerCase()
    const normalizedPassword = password.trim()

    if (!normalizedEmail) {
      setError('Введите email.')
      return
    }

    if (normalizedPassword.length < 6) {
      setError('Пароль должен быть не короче 6 символов.')
      return
    }

    setLoading(true)
    try {
      if (!isSupabaseConfigured || !supabase) {
        throw new Error('Supabase не настроен: добавьте VITE_SUPABASE_URL и VITE_SUPABASE_ANON_KEY в .env')
      }

      if (mode === 'register') {
        const { data, error } = await supabase.auth.signUp({
          email: normalizedEmail,
          password: normalizedPassword,
          options: {
            emailRedirectTo: window.location.origin,
          },
        })

        if (error) {
          // If account exists, allow immediate login path instead of hard fail UX.
          if (error.message.toLowerCase().includes('user already registered')) {
            const { error: loginError } = await supabase.auth.signInWithPassword({
              email: normalizedEmail,
              password: normalizedPassword,
            })
            if (!loginError) return
          }
          throw error
        }

        if (data.session) {
          setSuccess('Регистрация успешна. Вы вошли в систему.')
        } else {
          // Some Supabase setups return no session even without explicit errors.
          // Try password login immediately so user can proceed when confirmation is disabled.
          const { error: loginAfterSignUpError } = await supabase.auth.signInWithPassword({
            email: normalizedEmail,
            password: normalizedPassword,
          })

          if (!loginAfterSignUpError) {
            setSuccess('Аккаунт создан. Вы вошли в систему.')
            return
          }

          if (loginAfterSignUpError.message.toLowerCase().includes('email not confirmed')) {
            setSuccess('Аккаунт создан, но email не подтвержден. Подтвердите пользователя в Supabase Dashboard > Authentication > Users.')
            return
          }

          throw loginAfterSignUpError
        }
      } else {
        const { error } = await supabase.auth.signInWithPassword({
          email: normalizedEmail,
          password: normalizedPassword,
        })
        if (error) throw error
      }
    } catch (e: unknown) {
      const message = e instanceof Error ? e.message : 'Ошибка авторизации'
      setError(mapAuthError(message))
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="flex min-h-screen items-center justify-center bg-slate-50 p-4">
      <div className="w-full max-w-sm space-y-6 rounded-2xl bg-white p-8 shadow-lg">
        <div className="text-center">
          <div className="mb-2 text-4xl">🇧🇬</div>
          <h1 className="text-xl font-bold text-slate-800">TaxBG Pro</h1>
          <p className="mt-1 text-sm text-slate-400">Налоговый учёт в Болгарии</p>
        </div>

        {!isSupabaseConfigured && (
          <p className="rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700">
            Supabase не настроен. Для разработки используйте локальный админ-вход ниже.
          </p>
        )}

        <div className="flex rounded-xl bg-slate-100 p-1">
          {(['login', 'register'] as Mode[]).map(m => (
            <button
              key={m}
              onClick={() => {
                setMode(m)
                setError(null)
                setSuccess(null)
              }}
              className={`flex-1 rounded-lg py-2 text-sm transition-colors ${
                mode === m ? 'bg-white font-medium shadow-sm' : 'text-slate-500'
              }`}
            >
              {m === 'login' ? 'Войти' : 'Регистрация'}
            </button>
          ))}
        </div>

        <div className="space-y-3">
          <div>
            <label className="mb-1 block text-xs text-slate-400">Email</label>
            <input
              type="email"
              value={email}
              onChange={e => setEmail(e.target.value)}
              placeholder="you@example.com"
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-violet-400 focus:outline-none"
            />
          </div>
          <div>
            <label className="mb-1 block text-xs text-slate-400">Пароль</label>
            <input
              type="password"
              value={password}
              onChange={e => setPassword(e.target.value)}
              placeholder="••••••••"
              className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-violet-400 focus:outline-none"
            />
          </div>
        </div>

        {error && <p className="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600">{error}</p>}
        {success && <p className="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-600">{success}</p>}

        <button
          onClick={handleSubmit}
          disabled={loading || !email || !password}
          className="w-full rounded-xl bg-violet-600 py-3 text-sm font-medium text-white hover:bg-violet-700 disabled:opacity-40"
        >
          {loading ? '...' : mode === 'login' ? 'Войти' : 'Создать аккаунт'}
        </button>

        <button
          onClick={handleAdminLogin}
          className="w-full rounded-xl border border-slate-200 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          Войти как админ (локально)
        </button>

        <p className="text-center text-xs text-slate-400">
          Данные хранятся локально. Синхронизация между устройствами - скоро.
        </p>
      </div>
    </div>
  )
}
</file>

