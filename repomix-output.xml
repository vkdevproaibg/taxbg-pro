function fmt(d: string) {
  // YYYY-MM-DD -> DD.MM.YYYY
  if (!d) return '________'
  const parts = d.split('-')
  if (parts.length === 3) return `${parts[2]}.${parts[1]}.${parts[0]}`
  return d
}

