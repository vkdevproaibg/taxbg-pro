      setLlmApiKey: (llmApiKey) => set({ llmApiKey }),
      setLlmModel: (llmModel) => set({ llmModel }),
      setUseCustomModelForChat: (useCustomModelForChat) => set({ useCustomModelForChat }),
    }),
    { name: 'taxbg-user' }
  )
)
