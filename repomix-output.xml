      date: dayInMonth(m, 5, 8),
      type: 'salary',
      amount: 1800,
      description: 'Заплата програмист 1',
    }, companyId))

    // Salary 2
    transactions.push(makeTransaction({
      date: dayInMonth(m, 6, 8),
      type: 'salary',
      amount: 1500,
      description: 'Заплата програмист 2',
