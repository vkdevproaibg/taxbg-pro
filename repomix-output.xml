                      {e.action}
                    </span>
                    <span
                      className="text-xs font-medium"
                      style={{ color: 'var(--text-secondary)' }}
                    >
                      {e.entity_type}
                    </span>
                  </div>
                  <span
                    className="text-xs whitespace-nowrap shrink-0"
                    style={{ color: 'var(--text-muted)' }}
