}

function Td({ children, mono = false, right = false }: { children: React.ReactNode; mono?: boolean; right?: boolean }) {
  return (
    <td className={`px-2 py-1 text-xs ${right ? 'text-right' : ''} ${mono ? 'font-mono' : ''}`}
      style={{ color: 'var(--text-primary)' }}>
      {children}
    </td>
  )
}

