function pick<K extends keyof typeof tr>(key: K, lang: AppLanguage): string {
  const entry = tr[key] as Record<AppLanguage, string>
  return entry[lang] ?? entry.ru
}

function pickFn(
  key: 'daysAgo',
  lang: AppLanguage,
): (n: number) => string {
  const entry = tr[key] as Record<AppLanguage, (n: number) => string>
  return entry[lang] ?? entry.ru
}

