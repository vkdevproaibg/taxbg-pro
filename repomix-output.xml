    (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) =>
      setForm(prev => {
        const children = [...prev.children]
        children[idx] = { ...children[idx], [field]: e.target.value }
        return { ...prev, children }
      })

