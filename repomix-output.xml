      description: 'AWS hosting',
      amount: 320,
      vatRate: 0, vatAmount: 0,
      counterparty: 'Amazon AWS',
      invoiceNumber: `AWS-${year}-${m}`,
    })

    // GitHub + Figma subscriptions
    txs.push({
