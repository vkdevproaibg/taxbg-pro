                        {item.theoryNote}
                      </p>
                    </div>
                  )}
                  {item.practiceNote && (
                    <div
                      className="px-3 py-2"
                      style={{ backgroundColor: '#fffbeb' }}>
                      <p
                        className="text-xs font-semibold mb-0.5"
