          },
          { label: 'Данък', value: result.incomeTax, color: 'text-red-500' },
          { label: 'Осигуровки/год', value: result.osigAnnual, color: 'text-orange-500' },
          { label: 'Данъчна тежест', value: null, pct: result.effectiveRate, color: 'text-violet-600' },
