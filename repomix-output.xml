                )}
                {item.deadline && (
                  <span
                    className="text-xs font-medium"
                    style={{ color: 'var(--danger)' }}>
                    ⏰ {item.deadline}
                  </span>
                )}
                {item.link && (
                  <a
                    href={item.link}
