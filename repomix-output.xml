      {/* ══════════════════════════════════════════════════════
          FORM FIELDS
         ══════════════════════════════════════════════════════ */}
      <div className="space-y-4">

        {/* ── ЛИЧНЫЕ ДАННЫЕ ─────────────────────────────────── */}
        <p className="text-xs font-semibold uppercase tracking-wider"
