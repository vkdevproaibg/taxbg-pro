                style={{
                  backgroundColor: 'var(--accent-light)',
                  color: 'var(--accent)',
                }}
              >
                {labels.review}
              </button>
              <button
                onClick={onDismiss}
                className="rounded-lg px-3 py-1.5 text-xs font-medium"
                style={{
                  border: '1px solid var(--border)',
