          <Row label="Общо разходи" editable onChange={v => set({ totalExpenses: v })} value={form.totalExpenses} />
          <Row label="Счетоводна печалба / загуба" value={form.accountingProfit} />
          <Row
            label="Непризнати разходи (ЗКПО)"
            editable
