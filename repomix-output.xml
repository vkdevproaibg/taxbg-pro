            {alert.title}
          </p>

          {alert.summary_ru && (
            <p className="text-xs mt-1" style={{ color: 'var(--text-secondary)' }}>
              {alert.summary_ru}
            </p>
          )}

          {alert.source_url && (
            <a
              href={alert.source_url}
              target="_blank"
              rel="noopener noreferrer"
              className="text-xs underline mt-1 inline-block"
              style={{ color: 'var(--accent)' }}
